Total Volume (m3) = SUM(FACT_PRODUCTION_QUALITY[VOLUME_M3])

Quality Pass Rate =
DIVIDE(
    CALCULATE(COUNTROWS(FACT_PRODUCTION_QUALITY), FACT_PRODUCTION_QUALITY[QUALITY_PASS] = TRUE()),
    COUNTROWS(FACT_PRODUCTION_QUALITY)
)

Rework Rate =
DIVIDE(
    CALCULATE(COUNTROWS(FACT_PRODUCTION_QUALITY), FACT_PRODUCTION_QUALITY[REWORK_FLAG] = TRUE()),
    COUNTROWS(FACT_PRODUCTION_QUALITY)
)

Rework Cost (CAD) = SUM(FACT_PRODUCTION_QUALITY[REWORK_COST_CAD])

Average Strength (MPa) = AVERAGE(FACT_PRODUCTION_QUALITY[STRENGTH_28D_MPA])

Average Process Efficiency = AVERAGE(FACT_PRODUCTION_QUALITY[PROCESS_EFFICIENCY])

Average Acquisition Score = AVERAGE(V_ACQUISITION_CANDIDATES[ACQUISITION_SCORE])

Priority Targets =
CALCULATE(
    DISTINCTCOUNT(V_ACQUISITION_CANDIDATES[TARGET_PLANT_ID]),
    V_ACQUISITION_CANDIDATES[RECOMMENDATION] = "Prioritize"
)
